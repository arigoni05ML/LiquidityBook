<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/lb_widget_bg">

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#e9eef8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="Today \u2014" />

    <TextView
        android:id="@+id/widget_dd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8b98b3"
        android:textSize="12sp"
        android:text="Open Liquidity Book to log a trade" />
</LinearLayout>
